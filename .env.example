# tianji-ai environment variables
#
# 当前仓库没有“无条件必需”的环境变量。
# 以下变量是代码里内置识别的 provider API key 名称：
# - 当你使用对应 provider，且通过默认 env 读取 API key 时，它们是必需的
# - 如果你不使用对应 provider，或改为在 JSON 配置中直接提供 apiKey / baseUrl / headers，则它们可选
# - 配置系统也支持任意 `${env:VAR_NAME}` 占位符，因此 .env.example 只列出当前代码内置识别的变量，不是完整白名单

# Provider API Key（使用 OpenAI 且走默认 env 读取时必需）
OPENAI_API_KEY=

# Provider API Key（使用 Anthropic 且走默认 env 读取时必需）
ANTHROPIC_API_KEY=

# Provider API Key（使用 Google 且走默认 env 读取时必需）
GOOGLE_GENERATIVE_AI_API_KEY=

# 可选
# 当前代码中没有其他“内置识别”的固定环境变量。
# 如需自定义 provider baseUrl / headers，优先在 tianji.config.json
# 或用户/工作区 JSON 配置文件中配置。
