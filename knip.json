{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["apps/node/src/bin.ts"],
  "workspaces": {
    "packages/shared": {
      "entry": ["scripts/*.ts"]
    },
    "apps/controlplane": {
      "entry": ["src/server.ts", "src/migrate-cli.ts", "src/token-cli.ts", "src/index.ts"],
      "ignoreDependencies": ["@testing-library/jest-dom"]
    }
  },
  "ignoreIssues": {
    ".agents/skills/**/assets/**": ["files"],
    ".claude/skills/**/assets/**": ["files"],
    ".factory/skills/**/assets/**": ["files"],
    "apps/node/src/__tests__/helpers/**": ["exports", "types"],
    "packages/agent/src/__tests__/helpers/**": ["exports", "types"],
    "packages/runtime/src/__tests__/helpers/**": ["exports", "types"],
    "apps/node/src/logger.ts": ["types"],
    "packages/agent/src/orchestration/executors/acp-executor.ts": ["files"]
  }
}
