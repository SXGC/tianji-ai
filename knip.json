{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["apps/controlplane/src/server.ts", "apps/node/src/bin.ts"],
  "workspaces": {
    "packages/shared": {
      "entry": ["scripts/*.ts"]
    }
  },
  "ignoreIssues": {
    "apps/node/src/__tests__/helpers/**": ["exports", "types"],
    "packages/agent/src/__tests__/helpers/**": ["exports", "types"],
    "packages/runtime/src/__tests__/helpers/**": ["exports", "types"],
    "apps/node/src/logger.ts": ["types"],
    "packages/agent/src/orchestration/executors/executor-types.ts": ["files"]
  }
}
