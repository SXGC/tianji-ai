{
  "name": "@tianji/node",
  "version": "0.0.1",
  "private": true,
  "description": "Minimal Tianji CLI application shell",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "tianji": "./bin/tianji.mjs"
  },
  "files": ["bin", "dist", "src", "README.md"],
  "scripts": {
    "build": "pnpm --filter @tianji/shared build && pnpm --filter @tianji/observer build && pnpm --filter @tianji/runtime build && pnpm --filter @tianji/agent build && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run src/__tests__/run-e2e.test.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.18.0",
    "@langchain/openai": "^1.3.1",
    "@tianji/agent": "workspace:*",
    "@tianji/observer": "workspace:*",
    "@tianji/shared": "workspace:*"
  },
  "devDependencies": {
    "@langchain/core": "^1.1.33",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": ["tianji", "node"],
  "license": "MIT"
}
