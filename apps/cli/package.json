{
  "name": "@tianji/cli",
  "version": "0.0.1",
  "private": true,
  "description": "Minimal Tianji CLI application shell",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "tianji": "./bin/tianji.mjs"
  },
  "files": ["bin", "dist", "src", "README.md"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "SMOKE_E2E=1 vitest run src/__tests__/smoke-e2e.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@langchain/openai": "^1.3.1",
    "@tianji/contracts": "workspace:*",
    "@tianji/runtime": "workspace:*",
    "@tianji/shared": "workspace:*"
  },
  "devDependencies": {
    "@langchain/core": "^1.1.33",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": ["tianji", "cli"],
  "license": "MIT"
}
