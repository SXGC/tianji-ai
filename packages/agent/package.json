{
  "name": "@tianji/agent",
  "version": "0.0.0",
  "description": "Agent orchestration and CLI-facing runtime bootstrap for tianji-ai",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tianji-agent": "./dist/acp-entry.js"
  },
  "files": ["dist", "src", "config"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:acp": "pnpm build && node scripts/build-acp-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.18.0",
    "@langchain/langgraph": "^1.2.2",
    "@tianji/observer": "workspace:*",
    "@tianji/runtime": "workspace:*",
    "@tianji/shared": "workspace:*",
    "turndown": "^7.2.4"
  },
  "peerDependencies": {
    "deepagents": "^1.8.4"
  },
  "devDependencies": {
    "@langchain/core": "^1.1.33",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6"
  },
  "keywords": ["tianji", "agent"],
  "license": "MIT"
}
