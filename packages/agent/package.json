{
  "name": "@tianji/agent",
  "version": "0.0.0",
  "description": "Agent orchestration and CLI-facing runtime bootstrap for tianji-ai",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tianji/runtime": "workspace:*",
    "@tianji/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "keywords": ["tianji", "agent"],
  "license": "MIT"
}
