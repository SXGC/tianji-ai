{
  "name": "@tianji/runtime",
  "version": "0.0.1",
  "description": "Session runtime for tianji-ai with deepagents-backed execution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "tianji.config.json"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.15",
    "@ai-sdk/openai": "^1.3.22",
    "@langchain/core": "^1.1.33",
    "@langchain/langgraph": "^1.2.2",
    "@langchain/openai": "^1.3.1",
    "@tianji/shared": "workspace:*",
    "ai": "^4.0.0",
    "deepagents": "^1.8.4",
    "langchain": "^1.2.34"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "keywords": ["tianji", "runtime", "deepagents", "session"],
  "license": "MIT"
}
