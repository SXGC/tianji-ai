{
  "name": "@tianji/runtime",
  "version": "0.0.1",
  "description": "Session runtime for tianji-ai with internal LangGraph orchestration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@langchain/core": "^1.1.31",
    "@langchain/langgraph": "^1.2.2",
    "@tianji/contracts": "workspace:*",
    "@tianji/llm": "workspace:*",
    "@tianji/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "tianji",
    "runtime",
    "langgraph",
    "session"
  ],
  "license": "MIT"
}
