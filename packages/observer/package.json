    "test:coverage": "vitest run --passWithNoTests --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@tianji/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
