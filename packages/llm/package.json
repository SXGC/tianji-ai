{
  "name": "@tianji/llm",
  "version": "0.0.1",
  "description": "LLM access layer for tianji-ai - provider-agnostic gateway and streaming interfaces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.15",
    "@ai-sdk/openai": "^1.3.22",
    "@tianji/contracts": "workspace:*",
    "@tianji/shared": "workspace:*",
    "ai": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "keywords": ["tianji", "llm", "ai", "gateway", "streaming"],
  "license": "MIT"
}
